}

@article{parkCellSegmentationfreeInference2021,
  title = {Cell Segmentation-Free Inference of Cell Types from in Situ Transcriptomics Data},
  author = {Park, Jeongbin and Choi, Wonyl and Tiesmeyer, Sebastian and Long, Brian and Borm, Lars E. and Garren, Emma and Nguyen, Thuc Nghi and Tasic, Bosiljka and Codeluppi, Simone and Graf, Tobias and Schlesner, Matthias and Stegle, Oliver and Eils, Roland and Ishaque, Naveed},

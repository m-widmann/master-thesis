@article{higashijimaDistributionProspectiveGlutamatergic2004,
  title = {Distribution of Prospective Glutamatergic, Glycinergic, and {{GABAergic}} Neurons in Embryonic and Larval Zebrafish},
  author = {Higashijima, Shin-Ichi and Mandel, Gail and Fetcho, Joseph R.},

@article{rupprechtDatabaseDeepLearning2021,
  title = {A Database and Deep Learning Toolbox for Noise-Optimized, Generalized Spike Inference from Calcium Imaging},
  author = {Rupprecht, Peter and Carta, Stefano and Hoffmann, Adrian and Echizen, Mayumi and Blot, Antonin and Kwan, Alex C. and Dan, Yang and Hofer, Sonja B. and Kitamura, Kazuo and Helmchen, Fritjof and Friedrich, Rainer W.},
  date = {2021-09},
  journaltitle = {Nature Neuroscience},
  shortjournal = {Nat. Neurosci.},
  volume = {24},
  number = {9},
  pages = {1324--1337},
  publisher = {Nature Publishing Group},
  issn = {1546-1726},
  doi = {10.1038/s41593-021-00895-5},
  url = {https://www.nature.com/articles/s41593-021-00895-5},
  urldate = {2025-12-09},
  abstract = {Inference of action potentials (‘spikes’) from neuronal calcium signals is complicated by the scarcity of simultaneous measurements of action potentials and calcium signals (‘ground truth’). In this study, we compiled a large, diverse ground truth database from publicly available and newly performed recordings in zebrafish and mice covering a broad range of calcium indicators, cell types and signal-to-noise ratios, comprising a total of more than 35 recording hours from 298 neurons. We developed an algorithm for spike inference (termed CASCADE) that is based on supervised deep networks, takes advantage of the ground truth database, infers absolute spike rates and outperforms existing model-based algorithms. To optimize performance for unseen imaging data, CASCADE retrains itself by resampling ground truth data to match the respective sampling rate and noise level; therefore, no parameters need to be adjusted by the user. In addition, we developed systematic performance assessments for unseen data, openly released a resource toolbox and provide a user-friendly cloud-based implementation.},
  langid = {english},
  keywords = {Ca2+ imaging,Extracellular recording,Neural circuits,Optogenetics},
  file = {C:\Users\ag-bahl\Zotero\storage\89LZPMZU\Rupprecht et al. - 2021 - A database and deep learning toolbox for noise-optimized, generalized spike inference from calcium i.pdf}
}

@misc{rupprechtSpikeInferenceCalcium2025,
  title = {Spike Inference from Calcium Imaging Data Acquired with {{GCaMP8}} Indicators},
  author = {Rupprecht, Peter and R{\'o}zsa, M{\'a}rton and Fang, Xusheng and Svoboda, Karel and Helmchen, Fritjof},
  year = 2025,
  month = nov,
  primaryclass = {New Results},
  pages = {2025.03.03.641129},
  publisher = {bioRxiv},
  issn = {2692-8205},
  doi = {10.1101/2025.03.03.641129},
  urldate = {2025-12-15},
  abstract = {For neuroscience to be reproducible, its key methods must be quantitative and interpretable. Calcium imaging is such a key method, but it records neuronal activity only indirectly and is therefore difficult to interpret. These difficulties arise from the kinetics, nonlinearity, and sensitivity of calcium indicators, but also from the methods used for signal analysis. Here, we evaluate how methods for spike inference can be optimized to interpret data with the recently developed calcium indicator GCaMP8. We find that the indicator linearity of GCaMP8 enables more accurate recovery of high-frequency spiking events and the detection of single action potentials. Ground truth recordings from mouse neocortex show that the most linear calcium variants, GCaMP8s and GCaMP8m -- but not GCaMP6, GCaMP7f, or GCaMP8f -- robustly detect isolated spikes in pyramidal neurons under realistic noise conditions. In addition, we fine-tune and benchmark existing algorithms for spike inference (CASCADE, OASIS, MLSpike) with GCaMP8 data, investigate spike inference for interneurons, and demonstrate how the fast rise time of GCaMP8 enables low-latency real-time detection of neuronal activity. Together, our study provides tools and guidelines to optimally process calcium signals with GCaMP8 and highlights the key role of linearity in improving the interpretability of calcium imaging.},
  archiveprefix = {bioRxiv},
  chapter = {New Results},
  copyright = {\copyright{} 2025, Posted by openRxiv. This pre-print is available under a Creative Commons License (Attribution-NonCommercial 4.0 International), CC BY-NC 4.0, as described at http://creativecommons.org/licenses/by-nc/4.0/},
  langid = {english},
  file = {C:\Users\ag-bahl\Zotero\storage\3KALTWEK\Rupprecht et al. - 2025 - Spike inference from calcium imaging data acquired with GCaMP8 indicators.pdf}
}


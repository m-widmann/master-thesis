@article{zelinaSignalingSwitchAxon2014,
  title = {Signaling {{Switch}} of the {{Axon Guidance Receptor Robo3}} during {{Vertebrate Evolution}}},
  author = {Zelina, Pavol and Blockus, Heike and Zagar, Yvrick and P{\'e}res, Am{\'e}lie and Friocourt, Fran{\c c}ois and Wu, Zhuhao and Rama, Nicolas and Fouquet, Coralie and Hohenester, Erhard and {Tessier-Lavigne}, Marc and Schweitzer, J{\"o}rn and Crollius, Hugues Roest and Ch{\'e}dotal, Alain},
  year = 2014,
  month = dec,
  journal = {Neuron},
  volume = {84},
  number = {6},
  pages = {1258--1272},
  issn = {0896-6273},
  doi = {10.1016/j.neuron.2014.11.004},
  urldate = {2026-02-02},
  abstract = {Development of neuronal circuits is controlled by evolutionarily conserved axon guidance molecules, including Slits, the repulsive ligands for roundabout (Robo) receptors, and Netrin-1, which mediates attraction through the DCC receptor. We discovered that the Robo3 receptor fundamentally changed its mechanism of action during mammalian evolution. Unlike other Robo receptors, mammalian Robo3 is~not a high-affinity receptor for Slits because of specific substitutions in the first immunoglobulin domain. Instead, Netrin-1 selectively triggers phosphorylation of mammalian Robo3 via Src kinases. Robo3 does not bind Netrin-1 directly but interacts with DCC. Netrin-1 fails to attract pontine neurons lacking Robo3, and attraction can be restored in~Robo3-/- mice by expression of mammalian, but~not nonmammalian, Robo3. We propose that Robo3 evolution was key to sculpting the mammalian brain by converting a receptor for Slit repulsion into one that both silences Slit repulsion and potentiates Netrin attraction.},
  file = {C\:\\Users\\ag-bahl\\Zotero\\storage\\W5ARC67Z\\Zelina et al. - 2014 - Signaling Switch of the Axon Guidance Receptor Robo3 during Vertebrate Evolution.pdf;C\:\\Users\\ag-bahl\\Zotero\\storage\\ZG3FFZHT\\S0896627314010046.html}
}

@article{zhangFastSensitiveGCaMP2023,
  title = {Fast and Sensitive {{GCaMP}} Calcium Indicators for Imaging Neural Populations},
  author = {Zhang, Yan and Rózsa, Márton and Liang, Yajie and Bushey, Daniel and Wei, Ziqiang and Zheng, Jihong and Reep, Daniel and Broussard, Gerard Joey and Tsang, Arthur and Tsegaye, Getahun and Narayan, Sujatha and Obara, Christopher J. and Lim, Jing-Xuan and Patel, Ronak and Zhang, Rongwei and Ahrens, Misha B. and Turner, Glenn C. and Wang, Samuel S.-H. and Korff, Wyatt L. and Schreiter, Eric R. and Svoboda, Karel and Hasseman, Jeremy P. and Kolb, Ilya and Looger, Loren L.},
  date = {2023-03},

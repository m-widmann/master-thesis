@misc{huangBehavioralAlignmentOrganizing2026,
  title = {Behavioral Alignment as an Organizing Principle in Sensory Coding},
  author = {Huang, Shuhong and Portugues, Ruben and Fitzgerald, James E.},
  year = 2026,

@article{kappelVisualRecognitionSocial2022,
  title = {Visual Recognition of Social Signals by a Tectothalamic Neural Circuit},
  author = {Kappel, Johannes M. and Förster, Dominique and Slangewal, Katja and Shainer, Inbal and Svara, Fabian and Donovan, Joseph C. and Sherman, Shachar and Januszewski, Michał and Baier, Herwig and Larsch, Johannes},
  date = {2022-08},
